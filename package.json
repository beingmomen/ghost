{
  "name": "beingmomen-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:client": "pnpm --filter ./apps/client build",
    "build:db": "pnpm --filter ./apps/db build",
    "build:server": "pnpm --filter ./apps/server build",
    "dev:client": "pnpm --filter ./apps/client dev",
    "dev:db": "pnpm --filter ./apps/db dev",
    "dev:server": "pnpm --filter ./apps/server dev",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "sharp", "@parcel/watcher", "esbuild", "unrs-resolver", "vue-demi"]
  }
}
