{
  "theme": "base",
  "fontFamily": "Inter, 'Segoe UI', Arial, sans-serif",
  "fontSize": 19,
  "themeVariables": {
    "fontFamily": "Inter, 'Segoe UI', Arial, sans-serif",
    "fontSize": "15px",
    "background": "transparent",
    "primaryColor": "#292524",
    "primaryBorderColor": "#57534e",
    "primaryTextColor": "#f5f5f4",
    "secondaryColor": "#1c1917",
    "tertiaryColor": "#0c0a09",
    "lineColor": "#a8a29e",
    "textColor": "#f5f5f4",
    "edgeLabelBackground": "#1c1917",
    "actorBkg": "#292524",
    "actorBorder": "#57534e",
    "actorTextColor": "#f5f5f4",
    "actorLineColor": "#44403c",
    "signalColor": "#d6d3d1",
    "signalTextColor": "#f5f5f4",
    "labelBoxBkgColor": "#292524",
    "labelBoxBorderColor": "#57534e",
    "labelTextColor": "#f5f5f4",
    "loopTextColor": "#d6d3d1",
    "noteBkgColor": "#3b2a0c",
    "noteBorderColor": "#fbbf24",
    "noteTextColor": "#fde68a",
    "activationBkgColor": "#292524",
    "activationBorderColor": "#57534e",
    "sequenceNumberColor": "#1c1917"
  },
  "themeCSS": ".accent rect, .accent polygon, .accent path { fill: #3b2a0c !important; stroke: #fbbf24 !important; stroke-width: 1.5px !important; } .accent .nodeLabel { color: #fbbf24 !important; font-weight: 600; } .sequenceNumber { fill: #1c1917 !important; } * { filter: none !important; }",
  "sequence": {
    "mirrorActors": false,
    "showSequenceNumbers": true,
    "actorMargin": 20,
    "messageMargin": 32,
    "noteMargin": 10,
    "boxMargin": 8,
    "wrap": false,
    "width": 130
  },
  "flowchart": {
    "curve": "basis",
    "htmlLabels": true,
    "nodeSpacing": 30,
    "rankSpacing": 30,
    "padding": 10
  }
}