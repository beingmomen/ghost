# ==========================================
# PORT MAPPING (Coolify will handle domains)
# ==========================================
CLIENT_PORT=3001
SERVER_PORT=1234
DB_PORT=9123

# ==========================================
# CLIENT (apps/client - Portfolio)
# ==========================================
BASE_URL=https://beingmomen.com
SITE_URL=https://beingmomen.com
LOGO=https://res.cloudinary.com/your-cloud/image/upload/your-logo

# ==========================================
# SERVER (apps/server - Express API)
# ==========================================
APP_NAME=Beingmomen
DATABASE_ATLAS=mongodb+srv://user:password@cluster.mongodb.net/db
FRONTEND_URL=https://beingmomen.com
FRONTEND_RESET_PASSWORD_URL=https://beingmomen.com/reset-password
JWT_SECRET=generate-a-64-byte-random-hex-string
JWT_EXPIRES_IN=5h
JWT_COOKIE_EXPIRES_IN=5
EMAIL_FROM=your@email.com
STAMP_MAIL=your@gmail.com
STAMP_PASSWORD=your-gmail-app-password

# ==========================================
# DB (apps/db - Dashboard)
# ==========================================
# GitHub token to download base-layer during build
GIGET_AUTH=ghp_xxxxxxxxxxxxxxxxxxxx
NUXT_API_BASE=https://api.beingmomen.com/api/v1
NUXT_BACKEND_BASE_URL=https://api.beingmomen.com
AUTH_ORIGIN=https://dashboard.beingmomen.com
NUXT_SESSION_PASSWORD=generate-a-32-char-random-string

# ==========================================
# SHARED (Cloudinary - used by client & server)
# ==========================================
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=your-preset
